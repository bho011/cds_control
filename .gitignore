# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/

# Logs and runtime files
logs/*
!logs/.gitkeep
!logs/peristaltic/
logs/peristaltic/*
!logs/peristaltic/.gitkeep
*.log
*.out

# Local backup files
*.bak_*

# Calibration output data
calibration_data/*.csv

# Archived/generated dashboard versions
nicegui_dashboard/pages/dashboard_page_before_*.py
nicegui_dashboard/static/dashboard_before_*.css

# Local archive / old generated versions (root-level only - docs/archive/
# is a separate, git-tracked documentation archive, not this)
/archive/backups/
/archive/old_dashboard_versions/

# Local archive only
/archive/

recipes/*.json.bak
recipes/dashboard_recipes.json

.claude/
calibration_data/*.bak
calibration_data/*_before_*.json
config/*.bak
